# Copy to .env and fill in from https://node4.io/proxies. Never commit .env.
NODE4_USER=
NODE4_PASS=
# Rotating Datacenter (8083), Rotating Unmetered (8084) or Residential (8082)
NODE4_GATEWAY=gw-rotating_datacenter.node4.io:8083
# One of your static proxies, for the static examples
NODE4_PROXY=
# REST API examples in api/ (Account Settings -> API & Webhooks)
NODE4_API_KEY=
# Webhook receivers in api/: the secret returned when the webhook was created
NODE4_WEBHOOK_SECRET=
